<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:label="Legacy Shell"
        android:theme="@android:style/Theme.Material.Light.DarkActionBar">

        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".MainActivity" android:exported="false" />

        <activity android:name=".profile.LegacyProfileActivity" android:exported="false" />

        <!--
          In a real integration this is where io.flutter.embedding.android.FlutterActivity
          (launched via FlutterActivity.withCachedEngine(ENGINE_ID).build(context)) would be
          declared. See bridge/RealFlutterEngineHost.kt.
        -->

    </application>

</manifest>
