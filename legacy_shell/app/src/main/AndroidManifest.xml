<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".LegacyShellApplication"
        android:label="Legacy Shell"
        android:theme="@android:style/Theme.Material.Light.DarkActionBar">

        <!-- Launcher: the readiness pipeline decides whether to show home or redirect (docs/adr/0012). -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".LoginActivity" android:exported="false" />

        <activity android:name=".profile.LegacyProfileActivity" android:exported="false" />

        <!-- Reachable from Flutter only via navigation.openNative's allowlist (docs/adr/0010). -->
        <activity android:name=".help.LegacyHelpActivity" android:exported="false" />

        <!-- See docs/adr/0005 — resolves via DeepLinkRouter, no migration logic of its own. -->
        <activity
            android:name=".deeplink.DeepLinkActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="migrationshowcase" android:host="open" />
            </intent-filter>
        </activity>

        <!--
          In a real integration io.flutter.embedding.android.FlutterActivity is declared
          here; RealFlutterEngineHost launches it with withCachedEngine(...). See
          bridge/RealFlutterEngineHost.kt.
        -->

    </application>

</manifest>
